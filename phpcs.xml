<?xml version="1.0"?>
<ruleset name="CustomStandard" namespace="Foundation\CS\CustomStandard">
    <description>The coding standard for Sabatier Foundation.</description>
    <autoload>./vendor/autoload.php</autoload>
    <arg name="extensions" value="php"/>
    <file>src</file>
    <file>tests</file>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
    <rule ref="Squiz.Classes.ClassFileName">
        <!-- Test suites declare their fixtures alongside the TestCase class. -->
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Classes.ValidClassName"/>
</ruleset>
