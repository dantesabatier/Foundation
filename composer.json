{
  "name": "sabatier/foundation",
  "description": "The Foundation framework defines a base layer of functionality that is required for almost all applications. ",
  "keywords": [
    "sabatier",
    "foundation",
    "predicate",
    "expression",
    "logic",
    "kvc",
    "kvo"
  ],
  "homepage": "https://github.com/dantesabatier/foundation",
  "license": "MIT",
  "authors": [
    {
      "name": "dantesabatier",
      "email": "dantesabatier@me.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-gettext": "*",
    "ext-dom": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.8",
    "vimeo/psalm": "^4.3",
    "squizlabs/php_codesniffer": "3.*",
    "jetbrains/phpstorm-attributes": "^1.0",
    "rector/rector": "^0.14.5"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.2",
      "ext-posix": "8.2"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\Foundation\\": "src"
    },
    "files": [
      "src/Constants.php",
      "src/ConstantsInternal.php",
      "src/DebugAdditions.php",
      "src/ErrorCodes.php",
      "src/ErrorDomains.php",
      "src/ErrorUserInfoKey.php",
      "src/KeyValueCodingInternal.php",
      "src/StandardAdditions.php",
      "src/URLAdditions.php",
      "src/UUIDAdditions.php",
      "src/ValueInternal.php",
      "src/Networking/NetworkingConstants.php",
      "src/Networking/ProxyTypes.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\Foundation\\Test\\": "tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "1.0-dev"
    }
  },
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  }
}
