{
  "name": "sabatier/foundation",
  "description": ":package_description",
  "keywords": [
    "sabatier",
    "foundation"
  ],
  "homepage": "https://github.com/dantesabatier/foundation",
  "license": "MIT",
  "authors": [
    {
      "name": ":dantesabatier",
      "homepage": "https://github.com/dantesabatier"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-gettext": "*",
    "ext-pcntl": "*",
    "ext-posix": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.8",
    "vimeo/psalm": "^4.3",
    "jetbrains/phpstorm-attributes": "^1.0"
  },
  "config": {
    "platform": {
      "ext-pcntl": "8.1",
      "ext-posix": "8.1"
    }
  },
  "autoload": {
    "psr-4": {
      "Sabatier\\Foundation\\": "src"
    },
    "files": [
      "src/Constants.php",
      "src/ConstantsInternal.php",
      "src/DebugAdditions.php",
      "src/ErrorCodes.php",
      "src/ErrorDomains.php",
      "src/ErrorUserInfoKey.php",
      "src/KeyValueCodingInternal.php",
      "src/StandardAdditions.php",
      "src/UUIDAdditions.php",
      "src/ValueInternal.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Sabatier\\Foundation\\Test\\": "tests"
    }
  },
  "scripts": {
    "psalm": "vendor/bin/psalm --config=psalm.xml"
  }
}
